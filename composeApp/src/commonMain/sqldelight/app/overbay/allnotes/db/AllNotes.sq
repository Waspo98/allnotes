CREATE TABLE notebook (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL DEFAULT '',
    accent TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE note_section (
    id TEXT PRIMARY KEY NOT NULL,
    notebook_id TEXT NOT NULL,
    title TEXT NOT NULL,
    accent TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (notebook_id) REFERENCES notebook(id) ON DELETE CASCADE
);

CREATE INDEX idx_note_section_notebook_id ON note_section(notebook_id);

CREATE TABLE note_page (
    id TEXT PRIMARY KEY NOT NULL,
    section_id TEXT NOT NULL,
    parent_page_id TEXT,
    title TEXT NOT NULL,
    blocks_json TEXT NOT NULL,
    is_pinned INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (section_id) REFERENCES note_section(id) ON DELETE CASCADE,
    FOREIGN KEY (parent_page_id) REFERENCES note_page(id) ON DELETE SET NULL
);

CREATE INDEX idx_note_page_section_id ON note_page(section_id);
CREATE INDEX idx_note_page_parent_id ON note_page(parent_page_id);
CREATE INDEX idx_note_page_pinned ON note_page(is_pinned);

CREATE TABLE workspace_meta (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 1,
    revision INTEGER NOT NULL DEFAULT 1,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE deleted_entity (
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    deleted_at_epoch_ms INTEGER NOT NULL,
    PRIMARY KEY (id, kind)
);

CREATE TABLE workspace_preferences (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 1,
    prefs_json TEXT NOT NULL
);

-- ========================================================
-- Notebook Queries
-- ========================================================

selectAllNotebooks:
SELECT *
FROM notebook
ORDER BY sort_order ASC, title ASC;

selectNotebookById:
SELECT *
FROM notebook
WHERE id = :id;

insertNotebook:
INSERT OR REPLACE INTO notebook (
    id,
    title,
    subtitle,
    accent,
    sort_order,
    updated_at_epoch_ms
) VALUES (
    :id,
    :title,
    :subtitle,
    :accent,
    :sortOrder,
    :updatedAtEpochMs
);

updateNotebook:
UPDATE notebook
SET title = :title,
    subtitle = :subtitle,
    accent = :accent,
    sort_order = :sortOrder,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

deleteNotebook:
DELETE FROM notebook
WHERE id = :id;

deleteAllNotebooks:
DELETE FROM notebook;

-- ========================================================
-- NoteSection Queries
-- ========================================================

selectAllSections:
SELECT *
FROM note_section
ORDER BY sort_order ASC, title ASC;

selectSectionsByNotebook:
SELECT *
FROM note_section
WHERE notebook_id = :notebookId
ORDER BY sort_order ASC, title ASC;

selectSectionById:
SELECT *
FROM note_section
WHERE id = :id;

insertSection:
INSERT OR REPLACE INTO note_section (
    id,
    notebook_id,
    title,
    accent,
    sort_order,
    updated_at_epoch_ms
) VALUES (
    :id,
    :notebookId,
    :title,
    :accent,
    :sortOrder,
    :updatedAtEpochMs
);

updateSection:
UPDATE note_section
SET notebook_id = :notebookId,
    title = :title,
    accent = :accent,
    sort_order = :sortOrder,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

deleteSection:
DELETE FROM note_section
WHERE id = :id;

deleteSectionsByNotebook:
DELETE FROM note_section
WHERE notebook_id = :notebookId;

deleteAllSections:
DELETE FROM note_section;

-- ========================================================
-- NotePage Queries
-- ========================================================

selectAllPages:
SELECT *
FROM note_page
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

selectPagesBySection:
SELECT *
FROM note_page
WHERE section_id = :sectionId
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

selectPageById:
SELECT *
FROM note_page
WHERE id = :id;

selectSubpages:
SELECT *
FROM note_page
WHERE parent_page_id = :parentPageId
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

insertPage:
INSERT OR REPLACE INTO note_page (
    id,
    section_id,
    parent_page_id,
    title,
    blocks_json,
    is_pinned,
    updated_at_epoch_ms
) VALUES (
    :id,
    :sectionId,
    :parentPageId,
    :title,
    :blocksJson,
    :isPinned,
    :updatedAtEpochMs
);

updatePageTitle:
UPDATE note_page
SET title = :title,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

updatePageBlocks:
UPDATE note_page
SET blocks_json = :blocksJson,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

updatePagePin:
UPDATE note_page
SET is_pinned = :isPinned,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

updatePageParent:
UPDATE note_page
SET parent_page_id = :parentPageId,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

deletePage:
DELETE FROM note_page
WHERE id = :id;

deletePagesBySection:
DELETE FROM note_page
WHERE section_id = :sectionId;

deleteAllPages:
DELETE FROM note_page;

searchPages:
SELECT *
FROM note_page
WHERE title LIKE ('%' || :query || '%') OR blocks_json LIKE ('%' || :query || '%')
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

-- ========================================================
-- WorkspaceMeta Queries
-- ========================================================

getMetaRevision:
SELECT revision
FROM workspace_meta
WHERE id = 1;

getWorkspaceMeta:
SELECT *
FROM workspace_meta
WHERE id = 1;

updateMetaRevision:
INSERT OR REPLACE INTO workspace_meta (
    id,
    revision,
    updated_at_epoch_ms
) VALUES (
    1,
    :revision,
    :updatedAtEpochMs
);

deleteAllWorkspaceMeta:
DELETE FROM workspace_meta;

-- ========================================================
-- Tombstones & Preferences Queries
-- ========================================================

selectAllDeletedEntities:
SELECT *
FROM deleted_entity
ORDER BY deleted_at_epoch_ms DESC;

upsertDeletedEntity:
INSERT OR REPLACE INTO deleted_entity (
    id,
    kind,
    deleted_at_epoch_ms
) VALUES (
    :id,
    :kind,
    :deletedAtEpochMs
);

deleteTombstone:
DELETE FROM deleted_entity
WHERE id = :id AND kind = :kind;

deleteAllDeletedEntities:
DELETE FROM deleted_entity;

getWorkspacePreferences:
SELECT prefs_json
FROM workspace_preferences
WHERE id = 1;

upsertWorkspacePreferences:
INSERT OR REPLACE INTO workspace_preferences (
    id,
    prefs_json
) VALUES (
    1,
    :prefsJson
);
