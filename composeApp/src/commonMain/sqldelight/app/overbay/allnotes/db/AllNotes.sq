CREATE TABLE notebook (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL DEFAULT '',
    accent TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE note_section (
    id TEXT PRIMARY KEY NOT NULL,
    notebook_id TEXT NOT NULL,
    title TEXT NOT NULL,
    accent TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (notebook_id) REFERENCES notebook(id) ON DELETE CASCADE
);

CREATE INDEX idx_note_section_notebook_id ON note_section(notebook_id);

CREATE TABLE note_page (
    id TEXT PRIMARY KEY NOT NULL,
    section_id TEXT NOT NULL,
    parent_page_id TEXT,
    title TEXT NOT NULL,
    blocks_json TEXT NOT NULL,
    is_pinned INTEGER NOT NULL DEFAULT 0,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (section_id) REFERENCES note_section(id) ON DELETE CASCADE,
    FOREIGN KEY (parent_page_id) REFERENCES note_page(id) ON DELETE SET NULL
);

CREATE INDEX idx_note_page_section_id ON note_page(section_id);
CREATE INDEX idx_note_page_parent_id ON note_page(parent_page_id);
CREATE INDEX idx_note_page_pinned ON note_page(is_pinned);
CREATE INDEX idx_note_page_section_sort ON note_page(section_id, is_pinned DESC, updated_at_epoch_ms DESC);

CREATE TABLE workspace_meta (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 1,
    revision INTEGER NOT NULL DEFAULT 1,
    updated_at_epoch_ms INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE deleted_entity (
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    deleted_at_epoch_ms INTEGER NOT NULL,
    PRIMARY KEY (id, kind)
);

CREATE INDEX idx_deleted_entity_ts ON deleted_entity(deleted_at_epoch_ms DESC);

CREATE TABLE workspace_preferences (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 1,
    prefs_json TEXT NOT NULL
);

-- ========================================================
-- Notebook Queries
-- ========================================================

selectAllNotebooks:
SELECT *
FROM notebook
ORDER BY sort_order ASC, title ASC;

selectNotebookIds:
SELECT id FROM notebook;

insertNotebook:
INSERT INTO notebook (
    id,
    title,
    subtitle,
    accent,
    sort_order,
    updated_at_epoch_ms
) VALUES (
    :id,
    :title,
    :subtitle,
    :accent,
    :sortOrder,
    :updatedAtEpochMs
)
ON CONFLICT(id) DO UPDATE SET
    title = excluded.title,
    subtitle = excluded.subtitle,
    accent = excluded.accent,
    sort_order = excluded.sort_order,
    updated_at_epoch_ms = excluded.updated_at_epoch_ms;

deleteNotebook:
DELETE FROM notebook
WHERE id = :id;

-- ========================================================
-- NoteSection Queries
-- ========================================================

selectAllSections:
SELECT *
FROM note_section
ORDER BY sort_order ASC, title ASC;

selectSectionsByNotebook:
SELECT *
FROM note_section
WHERE notebook_id = :notebookId
ORDER BY sort_order ASC, title ASC;

selectSectionById:
SELECT *
FROM note_section
WHERE id = :id;

selectSectionIds:
SELECT id FROM note_section;

insertSection:
INSERT INTO note_section (
    id,
    notebook_id,
    title,
    accent,
    sort_order,
    updated_at_epoch_ms
) VALUES (
    :id,
    :notebookId,
    :title,
    :accent,
    :sortOrder,
    :updatedAtEpochMs
)
ON CONFLICT(id) DO UPDATE SET
    notebook_id = excluded.notebook_id,
    title = excluded.title,
    accent = excluded.accent,
    sort_order = excluded.sort_order,
    updated_at_epoch_ms = excluded.updated_at_epoch_ms;

deleteSection:
DELETE FROM note_section
WHERE id = :id;

-- ========================================================
-- NotePage Queries
-- ========================================================

selectAllPages:
SELECT *
FROM note_page
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

selectPagesBySection:
SELECT *
FROM note_page
WHERE section_id = :sectionId
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

selectPageById:
SELECT *
FROM note_page
WHERE id = :id;

selectSubpages:
SELECT *
FROM note_page
WHERE parent_page_id = :parentPageId
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

selectPageIds:
SELECT id FROM note_page;

insertPage:
INSERT INTO note_page (
    id,
    section_id,
    parent_page_id,
    title,
    blocks_json,
    is_pinned,
    updated_at_epoch_ms
) VALUES (
    :id,
    :sectionId,
    :parentPageId,
    :title,
    :blocksJson,
    :isPinned,
    :updatedAtEpochMs
)
ON CONFLICT(id) DO UPDATE SET
    section_id = excluded.section_id,
    parent_page_id = excluded.parent_page_id,
    title = excluded.title,
    blocks_json = excluded.blocks_json,
    is_pinned = excluded.is_pinned,
    updated_at_epoch_ms = excluded.updated_at_epoch_ms;

updatePageParent:
UPDATE note_page
SET parent_page_id = :parentPageId,
    updated_at_epoch_ms = :updatedAtEpochMs
WHERE id = :id;

deletePage:
DELETE FROM note_page
WHERE id = :id;

searchPages:
SELECT *
FROM note_page
WHERE title LIKE ('%' || :query || '%') OR blocks_json LIKE ('%' || :query || '%')
ORDER BY is_pinned DESC, updated_at_epoch_ms DESC;

-- ========================================================
-- WorkspaceMeta Queries
-- ========================================================

getWorkspaceMeta:
SELECT *
FROM workspace_meta
WHERE id = 1;

updateMetaRevision:
INSERT INTO workspace_meta (
    id,
    revision,
    updated_at_epoch_ms
) VALUES (
    1,
    :revision,
    :updatedAtEpochMs
)
ON CONFLICT(id) DO UPDATE SET
    revision = excluded.revision,
    updated_at_epoch_ms = excluded.updated_at_epoch_ms;

-- ========================================================
-- Tombstones & Preferences Queries
-- ========================================================

selectAllDeletedEntities:
SELECT *
FROM deleted_entity
ORDER BY deleted_at_epoch_ms DESC;

selectDeletedEntityKeys:
SELECT id, kind FROM deleted_entity;

upsertDeletedEntity:
INSERT INTO deleted_entity (
    id,
    kind,
    deleted_at_epoch_ms
) VALUES (
    :id,
    :kind,
    :deletedAtEpochMs
)
ON CONFLICT(id, kind) DO UPDATE SET
    deleted_at_epoch_ms = excluded.deleted_at_epoch_ms;

deleteTombstone:
DELETE FROM deleted_entity
WHERE id = :id AND kind = :kind;

getWorkspacePreferences:
SELECT prefs_json
FROM workspace_preferences
WHERE id = 1;

upsertWorkspacePreferences:
INSERT INTO workspace_preferences (
    id,
    prefs_json
) VALUES (
    1,
    :prefsJson
)
ON CONFLICT(id) DO UPDATE SET
    prefs_json = excluded.prefs_json;
