# Optional bearer token required by /api/v1/sync.
# Leave blank only on a trusted local network or when using reverse-proxy auth.
ALLNOTES_AUTH_TOKEN=

# Set to true only behind an Authentik forward-auth reverse proxy that strips
# client-supplied auth headers and sets X-authentik-username.
TRUST_AUTHENTIK_HEADERS=false

# Comma-separated browser origins allowed by CORS (localhost is always permitted).
ALLNOTES_ALLOWED_ORIGINS=https://notes.example.com
